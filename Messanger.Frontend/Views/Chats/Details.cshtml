@model int
 
@{



}


<div class="text-center">
    <h2 id="NameOfGroup"> </h2>
    <h3 id="Chatters"></h3> 
    <ul id="messages">

    </ul>
    
	<form onsubmit = "SendMsg(event)">
            <input type = "text" id = "message" class="form-control" />
		<button type="submit" class="btn btn-primary"> отправить сообщение </button>
        <p id="error-alert" style="color:red;"></p>
    </form>
</div>




<script>
        async function SendMsg(){ 
            let errorAlert = document.getElementById("error-alert");
            errorAlert.style.display = "none";
            try {
                const data =
                {
                    text: document.getElementById("message").value
                };
                    const ChatId = @Model;
                    const res = await fetch(`https://localhost:5030/chats/${ChatId}/messages`, {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
            });
                if (res.status === 201 || res.status === 200) { 
                    const chats = Array.isArray(data) ? data : [data];
                    let htmlContent = data.map(message => `
                            <li>
                                <h3>Автор: ${message.authorName}</h3>
                                <h4>${message.text}</h4>
                                <h4>     ${message.createdAt}</h4>
                            </li>
                    `).join('');

                         document.getElementById('messages').innerHTML = htmlContent;
                         errorAlert.innerText = "успешно!";
                }
                else
                {

                errorAlert.innerText = "Не удалось получить данные";
                }
            }
            catch (error)
            {
                errorAlert.innerText = "Не удалось связаться с серверомwtf.";
                errorAlert.style.display = "block";
                console.error("Ошибка:", error);
            }
        }

        async function GetMessages()
        {
            let errorAlert = document.getElementById("error-alert");
            errorAlert.style.display = "none";
            try {
                    let ChatId = @Model; 
                    const res = await fetch(`https://localhost:5030/chats/${ChatId}/messages`, {
                    method: "GET",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" }
            });
                 
                if (res.status === 201 || res.status === 200) {
                    data = await res.json();
                    const chats = Array.isArray(data) ? data : [data]; 
                    let htmlContent = data.map(message => ` 
                            <li>
                                <h3>Автор: ${message.authorName}</h3>
                                <h4>${message.text}</h4>
                                <h4>     $${(new Date(message.createdAt).toLocaleString())}</h4>
                            </li>
                    `).join('');
                                
                         document.getElementById('messages').innerHTML = htmlContent;
                }
                else
                {

                errorAlert.innerText = "Не удалось получить данные";
                }
            }
            catch (error)
            {
                errorAlert.innerText = "Не удалось связаться с серверомwtf.";
                errorAlert.style.display = "block";
                console.error("Ошибка:", error);
            }
        }
        async function GetChatById()
        { 
            let errorAlert = document.getElementById("error-alert");
            errorAlert.style.display = "none";
            try { 
                    const ChatId = @Model;
                    const res = await fetch('https://localhost:5030/chats/${ChatId}', {
                    method: "GET",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" }
            }); 
            
                if (res.status === 201 || res.status === 200) { 
                    data = await res.json();
                    const chats = Array.isArray(data) ? data : [data];
                    document.getElementById("NameOfGroup").innerText = chats[0].name;
                    document.getElementById("Chatters").innerText = chats[0].users.join(', ');
                }
                else
                {

                errorAlert.innerText = "Не удалось получить данные";
                }
            }
            catch (error)
            {
                errorAlert.innerText = "Не удалось связаться с серверомwtf.";
                errorAlert.style.display = "block";
                console.error("Ошибка:", error);
            }
        }

        async function AuthMe()
        {

            const res = await fetch('https://localhost:5030/auth/me', {
                method: "GET",
                credentials: "include",
                headers: { "Content-Type": "application/json" }
            });
            if (res.status === 201 || res.status === 200)
            {
                 
                GetMessages();
                GetChatById();

                
            }
            if(res.status === 401) {
                    window.location.href = "/Account/Login";
            }
        }

    document.addEventListener("DOMContentLoaded", function()
    {
        AuthMe();
    });
</script>